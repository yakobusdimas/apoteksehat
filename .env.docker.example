# ============================================================================
# APOTEK - Docker Environment Variables
# ============================================================================
# 📋 Instructions:
#   1. Copy this file to .env and fill in your values
#      cp .env.docker.example .env
#   
#   2. For local development (without Docker), set these as environment variables
#      or use a text editor to uncomment and modify the lines below
#   
#   3. For Docker Compose, these are automatically loaded from docker-compose.yml
# ============================================================================

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# 🔴 CHANGE PASSWORD BEFORE PRODUCTION!
POSTGRES_DB=apotek_db
POSTGRES_USER=apotek_user
POSTGRES_PASSWORD=apotek_password_local  # Change this for production

# This URL is used by the backend container (internal Docker network)
DATABASE_URL=postgresql://apotek_user:apotek_password_local@postgres:5432/apotek_db

# For LOCAL development (outside Docker), use localhost instead of 'postgres'
# DATABASE_URL_LOCAL=postgresql://apotek_user:apotek_password_local@localhost:5432/apotek_db

# ── Flask Backend ─────────────────────────────────────────────────────────────
FLASK_ENV=production        # Set to 'development' for debug mode
FLASK_DEBUG=false           # Set to 'true' for detailed error pages
# Server Port
PORT=5000                   # Backend API port
BACKEND_API_URL=http://localhost:5000

# 🔐 SECURITY: Change these for production!
SECRET_KEY=replace-with-at-least-32-random-characters-for-production
JWT_SECRET_KEY=replace-with-another-32-random-characters-for-production

# CORS: Allowed origins for frontend requests
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Chatbot Configuration ────────────────────────────────────────────────────
MIN_CONFIDENCE=0.9          # Minimum confidence threshold for ML model (0.0-1.0)
MAX_MESSAGE_LENGTH=500      # Maximum message length in characters

# ── Admin Account (created on first run) ─────────────────────────────────────
ADMIN_EMAIL=admin@apoteksehat.com
ADMIN_PASSWORD=replace-with-strong-admin-password  # Minimum 12 chars; change this!
ADMIN_NAME=Administrator

# ── Frontend Configuration ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000
VITE_CHATBOT_API_URL=http://localhost:5000

# ── Payment Server ────────────────────────────────────────────────────────
# URL backend untuk sinkronisasi status pembayaran
BACKEND_API_URL=http://localhost:5000

# Midtrans Keys

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=731750821371-f71nhaj0fi3ov141hf6rq00n0go4usgj.apps.googleusercontent.com

# ============================================================================
# 🚀 Quick Start:
#   docker-compose up --build
#   
# Then visit:
#   - Frontend: http://localhost:5173
#   - Adminer:  http://localhost:8080 (PostgreSQL admin UI)
#   - API Docs: http://localhost:5000/api/health
# ============================================================================
